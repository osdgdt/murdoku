rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    // Campaign admins. The original owner's uid stays hard-coded on purpose:
    // a typo in the `admins` collection can then never lock the owner out.
    // Anyone else is an admin if a document `admins/{their uid}` exists
    // (create it by hand in the Firebase console; clients cannot write it).
    function isOwner() {
      return isSignedIn() && (
        request.auth.uid == "say3jOf6WkaXDmjyn3kmAKNYbCh1" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /admins/{uid} {
      // Each user may only check their own entry (used to show/hide the editor).
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    match /users/{userId}/campaignProgress/{campaignId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/achievements/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---- Statistics of the campaign cases (see src/campaign/statsStore.js) ----------------
    // `caseStats/{campaignId__caseId}` holds the totals over all the players of a case. A player
    // may change it only together with THEIR OWN marker `users/{uid}/caseStats/{caseKey}` being
    // created (a player starting a case) or flipped to solved (the same player solving it), in the
    // same batch: so each player counts once per case, and one batch moves the totals by at most
    // one player and by bounded amounts. The numbers remain self-reported (indicative, not exact).
    // Keep the bounds in step with LIMITS in src/campaign/statsMath.js.
    match /users/{userId}/caseStats/{caseKey} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['started', 'solved'])
        && request.resource.data.started == true
        && request.resource.data.solved is bool;
      // only ever from "not solved" to "solved"
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solved'])
        && resource.data.solved != true
        && request.resource.data.solved == true;
    }

    match /caseStats/{caseKey} {
      function markerPath() {
        return /databases/$(database)/documents/users/$(request.auth.uid)/caseStats/$(caseKey);
      }
      function before(field) { return resource == null ? 0 : resource.data.get(field, 0); }
      function delta(field) { return request.resource.data.get(field, 0) - before(field); }
      function knownCase() {
        return caseKey.matches('^[A-Za-z0-9_]{1,100}__[A-Za-z0-9_]{1,100}$')
          && exists(/databases/$(database)/documents/campaigns/$(caseKey.split('__')[0]));
      }
      function onlyCounters() {
        return request.resource.data.keys().hasOnly(['starts', 'solves', 'totalSeconds', 'totalHints', 'totalChecks']);
      }
      function noSolve() {
        return delta('solves') == 0 && delta('totalSeconds') == 0 && delta('totalHints') == 0 && delta('totalChecks') == 0;
      }
      function oneSolve() {
        return delta('solves') == 1
          && delta('totalSeconds') >= 1 && delta('totalSeconds') <= 86400
          && delta('totalHints') >= 0 && delta('totalHints') <= 50
          && delta('totalChecks') >= 0 && delta('totalChecks') <= 200;
      }
      function markerCreated() {
        return !exists(markerPath()) && existsAfter(markerPath());
      }
      function markerSolvedNow() {
        return exists(markerPath()) && existsAfter(markerPath())
          && get(markerPath()).data.solved != true && getAfter(markerPath()).data.solved == true;
      }
      // a new player: one more start (and, if they come in already solved, their solve too)
      function newPlayer() {
        return markerCreated() && delta('starts') == 1
          && (noSolve() || (getAfter(markerPath()).data.solved == true && oneSolve()));
      }
      // a known player solving: one solve, no new start
      function playerSolved() {
        return markerSolvedNow() && delta('starts') == 0 && oneSolve();
      }

      // one case at a time, by its key: no listing of the collection
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() && knownCase() && onlyCounters() && (newPlayer() || playerSolved());
      allow delete: if false;
    }

    // ---- Daily challenge (see src/daily/dailyStore.js and dailyMath.js) ----------------------------------
    // One scored run per player per day, ranked by time. Entries are created once and never changed; the day must
    // be today (UTC) as the SERVER sees it, the time is bounded, and the nickname must be the one the player
    // reserved. What rules cannot know is whether the case was really solved or how long it really took: the
    // numbers are self-reported, so the board is a friendly one, not a proof (stated on the Privacy page).
    // Keep the bounds in step with LIMITS in src/daily/dailyMath.js.
    function nicknameOk(n) {
      return n is string && n.size() >= 3 && n.size() <= 20 && n.matches('^[\\p{L}\\p{N} ._\'-]+$') && n.matches('.*[\\p{L}\\p{N}].*');
    }
    function two(n) { return n < 10 ? '0' + string(n) : string(n); }
    function todayKey() { return string(request.time.year()) + '-' + two(request.time.month()) + '-' + two(request.time.day()); }
    function validRun(d) {
      return d.keys().hasOnly(['nickname', 'seconds', 'checks', 'caseId', 'createdAt'])
        && nicknameOk(d.nickname)
        && d.seconds is int && d.seconds >= 20 && d.seconds <= 86400
        && d.checks is int && d.checks >= 0 && d.checks <= 200
        && d.caseId is string && d.caseId.size() <= 100
        && d.createdAt == request.time;
    }

    // A player's nickname: their profile, and a reservation named after it (lower case) so that two players cannot
    // take the same one. Both are written together; renaming deletes the old reservation.
    match /profiles/{userId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'key'])
        && nicknameOk(request.resource.data.nickname)
        && request.resource.data.key == request.resource.data.nickname.lower()
        && existsAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.key))
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.key)).data.uid == request.auth.uid;
    }
    match /nicknames/{key} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && nicknameOk(key) && key == key.lower();
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // The player's own copy of each run (lets them see it, and delete the public one with "delete my data").
    match /users/{userId}/dailyEntries/{dateKey} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && dateKey == todayKey() && validRun(request.resource.data);
      allow update: if false;
    }

    // The public board of a day.
    match /daily/{dateKey}/entries/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 50;
      allow create: if isSignedIn() && request.auth.uid == userId && dateKey == todayKey() && validRun(request.resource.data)
        && request.resource.data.nickname == get(/databases/$(database)/documents/profiles/$(userId)).data.nickname
        && existsAfter(/databases/$(database)/documents/users/$(userId)/dailyEntries/$(dateKey));
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ---- Shared cases (see src/community/ and functions/src/handlers.js) -----------------------------------------------
    // Anyone, signed in or not, reads a case: that is the point of a code you can pass on. Nobody writes any of it from the
    // page: publishing, revising, withdrawing and deleting go through the Cloud Functions (which use the admin SDK and so
    // are not subject to these rules), because only a server can enforce the limits per author, hand out codes without
    // collisions, keep the counters honest and check the case with the app's own validation.
    //  - the card `cases/{code}` is small and public; it can be listed (only the active ones, 30 at a time: no scraping);
    //  - the case itself, `cases/{code}/revisions/{n}`, is read one revision at a time and never listed;
    //  - a case that is withdrawn or hidden is readable only by its author and by the admins.
    // Keep the bounds in step with LIMITS in src/community/casePolicy.js.
    function isActiveCase(code) {
      return get(/databases/$(database)/documents/cases/$(code)).data.status == 'active';
    }
    function isCaseAuthor(code) {
      return isSignedIn() && get(/databases/$(database)/documents/cases/$(code)).data.authorUid == request.auth.uid;
    }
    match /cases/{code} {
      allow get: if resource.data.status == 'active'
        || (isSignedIn() && resource.data.authorUid == request.auth.uid)
        || isOwner();
      allow list: if resource.data.status == 'active' && request.query.limit <= 30;
      allow write: if false;
      match /revisions/{revision} {
        allow get: if isActiveCase(code) || isCaseAuthor(code) || isOwner();
        allow list, write: if false;
      }
    }
    // The author's public name and how many cases they have out.
    match /authors/{userId} {
      allow get: if true;
      allow list: if request.query.limit <= 30;
      allow write: if false;
    }
    // The author's own list of what they published (the account deletion and the editor read it).
    match /users/{userId}/published/{code} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    // Server only: the per-day counters of the limits, the claimed fingerprints, the adjustable limits.
    match /users/{userId}/publishLog/{day} { allow read, write: if false; }
    match /caseHashes/{hash} { allow read, write: if false; }
    match /config/{doc} { allow read, write: if false; }
  }
}
