  "characters": [
    {
      "id": "char_mwo3ocekld55f53h",
      "name": "Ambrogio",
      "iconId": "lawyer",
      "isVictim": false,
      "bio": "Segretario dell'abate: custodisce i registri e i sigilli dell'abbazia. Preciso, riservato, sempre ben informato sugli affari del monastero.",
      "color": "#608aea",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocekbvdyppen",
      "name": "Benvenuto",
      "iconId": "glasses",
      "isVictim": false,
      "bio": "Copista anziano, miope e sospettoso. Lavora fianco a fianco con Valerio da anni e ne invidia la velocità.",
      "color": "#ea558a",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocekocwe2q6p",
      "name": "Teobaldo",
      "iconId": "artist",
      "isVictim": false,
      "bio": "Miniatore: illustra i codici più preziosi. Vive per i colori e per i pennelli; ha debiti con un mercante di Borgocenere.",
      "color": "#158060",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocek4kcxf1t3",
      "name": "Perpetua",
      "iconId": "librarian",
      "isVictim": false,
      "bio": "Monaca bibliotecaria: conosce a memoria ogni scaffale. Dice di aver sentito rumori nella notte, ma di non aver visto nulla.",
      "color": "#9f5595",
      "gender": "female"
    },
    {
      "id": "char_mwo3ocekwrufahs8",
      "name": "Federico",
      "iconId": "mechanic",
      "isVictim": false,
      "bio": "Rilegatore dell'abbazia: lavora la pelle, la colla e le borchie. Entra ed esce dallo scriptorium per ritirare i fogli, e nessuno lo nota più.",
      "color": "#bf8020",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocekmfuwxrm7",
      "name": "Valerio",
      "iconId": "hat",
      "isVictim": true,
      "bio": "22 anni, scrivano dello scriptorium. Una calligrafia perfetta e un occhio da contabile: leggeva ogni atto che copiava.",
      "color": "#4a6aca",
      "gender": "male"
    }
