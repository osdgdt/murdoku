  "characters": [
    {
      "id": "char_mwo3oced3wftl9or",
      "name": "Bertoldo",
      "iconId": "blacksmith",
      "isVictim": false,
      "bio": "Maestro fabbro e padrone della forgia. Burbero ma stimato, fornisce ferri e armi al presidio del castello. Ultimamente ha le mani piene di ordini e il carattere peggiorato.",
      "color": "#608aea",
      "gender": "male"
    },
    {
      "id": "char_mwo3oceddo4fmu5d",
      "name": "Lupo",
      "iconId": "construction",
      "isVictim": false,
      "bio": "Lavorante, forte come un bue e di poche parole. Vanni gli aveva preso il posto accanto alla fornace, e lui non l'ha mai nascosto.",
      "color": "#ea558a",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocedrfijmgln",
      "name": "Mabilia",
      "iconId": "baker",
      "isVictim": false,
      "bio": "Moglie del fabbro: tiene i conti e la cucina. Voleva bene al garzone come a un figlio, dice; ma la sera lo sentiva parlare di cose che non capiva.",
      "color": "#158060",
      "gender": "female"
    },
    {
      "id": "char_mwo3oced9zv200ny",
      "name": "Osvaldo",
      "iconId": "farmer",
      "isVictim": false,
      "bio": "Carbonaio di Borgocenere: porta il carbone alla forgia ogni mattina. Parla solo del tempo, ma vede tutto quello che entra ed esce dal cortile.",
      "color": "#9f5595",
      "gender": "male"
    },
    {
      "id": "char_mwo3oced7utz5xyb",
      "name": "Ilaria",
      "iconId": "maid",
      "isVictim": false,
      "bio": "Figlia del vasaio della porta accanto: porta ogni giorno la zuppa ai lavoranti. Si fermava a parlare con Vanni più del dovuto.",
      "color": "#bf8020",
      "gender": "female"
    },
    {
      "id": "char_mwo3ocedxrl1jzdz",
      "name": "Vanni",
      "iconId": "ninja",
      "isVictim": true,
      "bio": "19 anni, garzone della forgia di Borgocenere. Silenzioso e instancabile, è arrivato in bottega ancora bambino: nessuno sa chi fossero i suoi genitori.",
      "color": "#4a6aca",
      "gender": "male"
    }
