    },
    {
      "id": "char_mwm9lr4euayrnbnb",
      "name": "Benvenuto",
      "iconId": "glasses",
      "isVictim": false,
      "bio": "Copista anziano, miope e sospettoso. Lavora fianco a fianco con Valerio da anni e ne invidia la velocità.",
      "color": "#ea558a",
      "gender": "male"
    },
    {
