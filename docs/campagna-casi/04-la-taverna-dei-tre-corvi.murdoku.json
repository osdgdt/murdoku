  "characters": [
    {
      "id": "char_mwo3ocemuy9uu2wp",
      "name": "Rodolfo",
      "iconId": "soldier",
      "isVictim": false,
      "bio": "Rodolfo il Guercio, soldato di ventura con un occhio solo e molte cicatrici. Gioca a dadi con Vitale quasi ogni sera, e perde più spesso di quanto ammetta.",
      "color": "#608aea",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocemvv2rchwk",
      "name": "Gisulfo",
      "iconId": "banker",
      "isVictim": false,
      "bio": "Mercante di panni di passaggio a Borgocenere: ha preso una stanza ai Tre Corvi per una settimana. Paga bene e parla poco.",
      "color": "#ea558a",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocemd938ngf1",
      "name": "Orsola",
      "iconId": "waiter",
      "isVictim": false,
      "bio": "Cameriera dei Tre Corvi. Sa tutto di tutti: serve vino e ascolta. Si è fatta più guardinga da quando Vitale è morto.",
      "color": "#158060",
      "gender": "female"
    },
    {
      "id": "char_mwo3ocemwej30rc9",
      "name": "Drogone",
      "iconId": "farmer",
      "isVictim": false,
      "bio": "Mandriano delle colline, in paese solo per vendere le bestie. Beve forte e ha il pugno facile.",
      "color": "#9f5595",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocem266fthvf",
      "name": "Nerina",
      "iconId": "maid",
      "isVictim": false,
      "bio": "Lavandaia dei Tre Corvi: lava lenzuola e boccali, e raccoglie le chiacchiere insieme ai panni sporchi. Vitale le lasciava sempre una moneta.",
      "color": "#bf8020",
      "gender": "female"
    },
    {
