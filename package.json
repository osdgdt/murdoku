{
  "name": "murdoku",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Murdoku — editor e player di puzzle di deduzione. Il sito gira senza build: questo package.json serve solo agli strumenti di sviluppo (test, lint).",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node test/node/run.mjs && node tools/build-sw.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check \"src/**/*.js\" \"test/**/*.{js,mjs}\"",
    "i18n": "node tools/i18n-check.mjs",
    "check": "npm run lint && npm test && npm run check:size",
    "check:size": "node tools/check-size.mjs",
    "build:sw": "node tools/build-sw.mjs",
    "e2e": "node test/e2e/smoke.mjs",
    "e2e:a11y": "node test/e2e/a11y.mjs",
    "build": "node tools/build-sw.mjs",
    "e2e:editor": "node test/e2e/editor.mjs",
    "e2e:gameplay": "node test/e2e/gameplay.mjs",
    "e2e:update": "node test/e2e/update.mjs",
    "e2e:clues": "node test/e2e/clues.mjs",
    "e2e:a11y-keyboard": "node test/e2e/a11y-keyboard.mjs",
    "e2e:daily": "node test/e2e/daily.mjs",
    "e2e:community": "node test/e2e/community.mjs",
    "e2e:progress": "node test/e2e/progress.mjs",
    "e2e:i18n": "node test/e2e/i18n-pages.mjs",
    "e2e:touch": "node test/e2e/touch.mjs",
    "e2e:visual": "node test/e2e/visual.mjs",
    "e2e:visual:docker": "node tools/visual-docker.mjs",
    "e2e:floors": "node test/e2e/floors.mjs",
    "e2e:bigboard": "node test/e2e/bigboard.mjs",
    "e2e:all": "npm run e2e && npm run e2e:a11y && npm run e2e:editor && npm run e2e:progress && npm run e2e:gameplay && npm run e2e:clues && npm run e2e:a11y-keyboard && npm run e2e:daily && npm run e2e:community && npm run e2e:i18n && npm run e2e:touch && npm run e2e:floors && npm run e2e:bigboard && npm run e2e:update",
    "test:rules": "node test/rules/run.mjs",
    "test:functions": "node test/functions/run.mjs",
    "bench": "node test/bench/solver-bench.mjs",
    "check:case": "node tools/check-case.mjs",
    "make:library": "node tools/make-library.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.0"
  }
}
