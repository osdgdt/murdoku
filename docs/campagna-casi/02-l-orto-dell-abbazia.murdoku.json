  "characters": [
    {
      "id": "char_mwo3ocejq6h4xcsa",
      "name": "Anselmo",
      "iconId": "monk",
      "isVictim": false,
      "bio": "Fra Anselmo, infermiere dell'abbazia: conosce ogni pianta e ogni dose. Autorevole, di rado visto fuori dall'infermeria, se non per raccogliere erbe all'alba.",
      "color": "#608aea",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocejixdzwb39",
      "name": "Clemenza",
      "iconId": "nun",
      "isVictim": false,
      "bio": "Suor Clemenza, sorvegliante dell'orto e dell'infermeria: severa con le novizie. Rimproverava Violante per i ritardi, e per le sue visite fuori orario.",
      "color": "#ea558a",
      "gender": "female"
    },
    {
      "id": "char_mwo3ocej3osoqr04",
      "name": "Gherardo",
      "iconId": "gardener",
      "isVictim": false,
      "bio": "Giardiniere laico dell'abbazia. Lavora l'orto da vent'anni e non ha mai amato che altri mettessero le mani nelle sue aiuole.",
      "color": "#158060",
      "gender": "male"
    },
    {
      "id": "char_mwo3oceju35h4qeu",
      "name": "Dionigi",
      "iconId": "priest",
      "isVictim": false,
      "bio": "Frate portinaio: apre e chiude il portone dell'abbazia e sa chi è venuto e chi se n'è andato. Dorme poco e ascolta molto.",
      "color": "#9f5595",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocejgomwifcl",
      "name": "Eufemia",
      "iconId": "baker",
      "isVictim": false,
      "bio": "Cuoca del refettorio: prepara i pasti dei monaci e dei pellegrini. Ha le erbe in cucina quanto l'erborista le ha nell'orto, e non lo ha mai detto volentieri.",
      "color": "#bf8020",
      "gender": "female"
    },
    {
      "id": "char_mwo3ocejch0y06rc",
      "name": "Violante",
      "iconId": "pharmacist",
      "isVictim": true,
      "bio": "20 anni, erborista: cura le aiuole e prepara gli unguenti dell'infermeria. Teneva un erbario a cui non lasciava avvicinare nessuno.",
      "color": "#4a6aca",
      "gender": "female"
    }
  ],
