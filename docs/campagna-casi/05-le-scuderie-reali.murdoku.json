  "characters": [
    {
      "id": "char_mwo3ocen393gykvc",
      "name": "Aldobrando",
      "iconId": "knight",
      "isVictim": false,
      "bio": "Ser Aldobrando, cavaliere di molti tornei e di pochi scrupoli. Vince spesso, e di recente è il favorito per la giostra del re.",
      "color": "#608aea",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocenrnq3orht",
      "name": "Sigfrido",
      "iconId": "soldier",
      "isVictim": false,
      "bio": "Scudiero di ser Aldobrando: lucida le armi e porta la lancia. Fedele, o abituato a esserlo.",
      "color": "#ea558a",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocendhra5lw1",
      "name": "Brunone",
      "iconId": "construction",
      "isVictim": false,
      "bio": "Garzone di stalla, tutto muscoli e poco cervello. Venanzia lo sgridava per il fieno sprecato.",
      "color": "#158060",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocenwwegk9ta",
      "name": "Isolda",
      "iconId": "princess",
      "isVictim": false,
      "bio": "Dama della corte, appassionata di tornei: siede sempre in prima fila. Frequenta le scuderie più di quanto sia decoroso.",
      "color": "#9f5595",
      "gender": "female"
    },
    {
      "id": "char_mwo3ocenqd9bkhst",
      "name": "Ermengarda",
      "iconId": "maid",
      "isVictim": false,
      "bio": "Guardarobiera della corte: cura le insegne, i panni e gli stendardi del torneo. Ha le chiavi del magazzino.",
      "color": "#bf8020",
      "gender": "female"
    },
    {
      "id": "char_mwo3ocen4czk4tmo",
      "name": "Corrado",
      "iconId": "blacksmith",
      "isVictim": false,
      "bio": "Maniscalco delle scuderie: ferra i cavalli dei cavalieri e conosce il peso di ogni lancia. Venanzia gli portava i cavalli zoppi, e lui le dava sempre ragione.",
      "color": "#4a6aca",
      "gender": "male"
    },
    {
      "id": "char_mwo3ocenftalx52z",
      "name": "Venanzia",
      "iconId": "cowboy",
      "isVictim": true,
      "bio": "21 anni, palafreniera della corte. Conosce ogni cavallo per nome e ogni cavaliere per i suoi vizi.",
      "color": "#9f80b5",
      "gender": "female"
    }
