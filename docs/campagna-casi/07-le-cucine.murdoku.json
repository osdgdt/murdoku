  "characters": [
    {
      "id": "char_mwo3oceq9oeevdwi",
      "name": "Agnese",
      "iconId": "maid",
      "isVictim": false,
      "bio": "Dispensiera del castello: tiene le chiavi di cantine e dispense. Sa quanto vino e quanta carne entrano in cucina, e quanto ne esce.",
      "color": "#608aea",
      "gender": "female"
    },
    {
      "id": "char_mwo3oceqzq0oucb4",
      "name": "Tommaso",
      "iconId": "waiter",
      "isVictim": false,
      "bio": "Sguattero: lava le pentole e porta l'acqua. Valdo lo trattava meglio di quanto meritasse, dice.",
      "color": "#ea558a",
      "gender": "male"
    },
    {
      "id": "char_mwo3oceq84xg32bn",
      "name": "Lorenzo",
      "iconId": "butler",
      "isVictim": false,
      "bio": "Maestro di cucina, capo di tutti i fornelli. Aveva proposto un altro per il posto di cuoco del re.",
      "color": "#158060",
      "gender": "male"
    },
    {
      "id": "char_mwo3oceq5acj0hy4",
      "name": "Zaccaria",
      "iconId": "butcher",
      "isVictim": false,
      "bio": "Macellaio del castello: fornisce la carne e conosce i coltelli meglio di chiunque.",
      "color": "#9f5595",
      "gender": "male"
    },
    {
      "id": "char_mwo3oceq23u7vd5g",
      "name": "Nicola",
      "iconId": "baker",
      "isVictim": false,
      "bio": "Fornaio: all'alba è già al forno. Passa dalle cucine per le farine e per le uova.",
      "color": "#bf8020",
      "gender": "male"
    },
    {
      "id": "char_mwo3oceq2irnxa9i",
      "name": "Ginevra",
      "iconId": "farmer",
      "isVictim": false,
      "bio": "Lavandaia: porta i panni puliti e si ferma volentieri a chiacchierare.",
      "color": "#4a6aca",
      "gender": "female"
    },
    {
      "id": "char_mwo3oceqxh9gcrxu",
      "name": "Cesare",
      "iconId": "bartender",
      "isVictim": false,
      "bio": "Trinciante del re: taglia le carni a tavola e le assaggia prima di tutti. Valdo gli aveva portato via il posto accanto al re, e lui non lo ha scordato.",
      "color": "#9f80b5",
      "gender": "male"
    },
    {
      "id": "char_mwo3oceq7n210jpu",
      "name": "Valdo",
      "iconId": "chef",
      "isVictim": true,
      "bio": "22 anni, cuoco: promosso da poco cuoco personale del re. Ambizioso, orgoglioso del suo posto.",
      "color": "#6a9560",
      "gender": "male"
    }
