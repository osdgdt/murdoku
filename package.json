{
  "name": "murdoku",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Murdoku — editor e player di puzzle di deduzione. Il sito gira senza build: questo package.json serve solo agli strumenti di sviluppo (test, lint).",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node test/node/run.mjs && node tools/build-sw.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check \"src/**/*.js\" \"test/**/*.{js,mjs}\"",
    "i18n": "node tools/i18n-check.mjs",
    "check": "npm run lint && npm test",
    "build:sw": "node tools/build-sw.mjs",
    "e2e": "node test/e2e/smoke.mjs",
    "e2e:a11y": "node test/e2e/a11y.mjs",
    "build": "node tools/build-sw.mjs",
    "e2e:editor": "node test/e2e/editor.mjs",
    "e2e:all": "npm run e2e && npm run e2e:a11y && npm run e2e:editor",
    "make:library": "node tools/make-library.mjs",
    "make:tutorial": "node tools/make-tutorial.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.0"
  }
}
